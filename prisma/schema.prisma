generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
}

enum ProductWorkflowStatus {
  NEW
  REVIEWED
  APPROVED
  REJECTED
  PROMOTED
}

enum StockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
  UNKNOWN
}

enum ReturnRisk {
  LOW
  MEDIUM
  HIGH
  UNKNOWN
}

enum ContentKind {
  PRODUCT_SUMMARY
  PROMOTION_RATIONALE
  TARGET_AUDIENCE
  REEL_HOOKS
  REEL_SCRIPT_30
  REEL_SCRIPT_60
  CAPTION
  HASHTAGS
  CTA_OPTIONS
  THUMBNAIL_TEXT
  PROS
  CAUTIONS
  BUNDLE
}

enum PolicyStatus {
  DRAFT
  ACTIVE
  NEEDS_REVIEW
  RETIRED
}

enum PolicySeverity {
  LOW
  MEDIUM
  HIGH
  BLOCKING
}

enum SourceType {
  MANUAL
  API
  FEED
}

enum SourceStatus {
  READY
  RUNNING
  DEGRADED
  RATE_LIMITED
  DISABLED
}

enum IngestionTriggerType {
  MANUAL
  SCHEDULED
  RETRY
}

enum IngestionRunStatus {
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
  RETRY_SCHEDULED
}

enum MatchStatus {
  EXACT
  PROBABLE
  REVIEW
}

enum AvailabilityStatus {
  AVAILABLE
  UNAVAILABLE
  UNKNOWN
}

enum TrendSignalType {
  GOOGLE_TRENDS
  SOCIAL_MENTIONS
  MARKETPLACE_BESTSELLER
  REVIEW_GROWTH
  PRICE_DROP
  DISCOUNT_GROWTH
  AVAILABILITY
  CATEGORY_MOMENTUM
  SEASONAL_DEMAND
  FESTIVAL_DEMAND
  NEW_PRODUCT_VELOCITY
}

enum TrendDirection {
  SPIKING
  RISING
  STABLE
  DECAYING
}

enum ComplianceStatus {
  PASS
  WARNING
  FAIL
  OVERRIDDEN
}

enum ComplianceSeverity {
  INFO
  WARNING
  HIGH
  BLOCKING
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum CampaignPromotionStatus {
  PLANNED
  SCHEDULED
  PUBLISHED
  PAUSED
  FAILED
  ARCHIVED
}

enum ContentVariationStatus {
  ACTIVE
  WINNER
  LOSER
  ARCHIVED
}

enum TrackingDeviceType {
  MOBILE
  TABLET
  DESKTOP
  OTHER
  UNKNOWN
}

enum AffiliateOrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
  REFUNDED
}

enum AffiliateCommissionStatus {
  ESTIMATED
  PENDING
  APPROVED
  PAID
  REVERSED
}

enum ContentExperimentStatus {
  DRAFT
  RUNNING
  COMPLETED
  ARCHIVED
}

enum ExperimentPrimaryMetric {
  CLICKS
  CONVERSIONS
  CONVERSION_RATE
  COMMISSION
  EARNINGS_PER_CLICK
}

enum RecommendationFeedbackAction {
  APPROVED
  REJECTED
  PROMOTED
  SKIPPED
  SUCCESSFUL
  UNSUCCESSFUL
}

enum LearningDimension {
  CATEGORY
  MARKETPLACE
  PRICE_BAND
  COMMISSION_BAND
  CREATOR
  AUDIENCE
  HOOK
  CTA
  CAPTION_TONE
  SEASON
  FESTIVAL
}

enum ScoringWeightStatus {
  DRAFT
  ACTIVE
  ROLLED_BACK
}

enum AutomationJobType {
  PRODUCT_INGESTION
  PRICE_REFRESH
  AVAILABILITY_REFRESH
  TREND_REFRESH
  SCORE_RECALCULATION
  TOP_10_GENERATION
  CONTENT_GENERATION
  COMPLIANCE_CHECK
  SCORE_RETRAINING
  NOTIFICATION_SCAN
  NOTIFICATION_DELIVERY_RETRY
  SUMMARY_REPORT_GENERATION
}

enum AutomationJobStatus {
  HEALTHY
  PAUSED
  RUNNING
  DEGRADED
  FAILING
}

enum AutomationRunTrigger {
  SCHEDULED
  MANUAL
  RETRY
}

enum AutomationRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  TIMED_OUT
  SKIPPED
  BLOCKED
}

enum AutomationLogLevel {
  INFO
  WARN
  ERROR
}

enum NotificationType {
  DAILY_OPPORTUNITY_SUMMARY
  WEEKLY_PERFORMANCE_SUMMARY
  MONTHLY_EARNINGS_SUMMARY
  NEW_TRENDING_PRODUCT
  PRICE_DROP
  STOCK_RETURN
  AFFILIATE_RULE_CHANGE
  CAMPAIGN_PERFORMANCE
  LOW_CONVERSION
  HIGH_RETURN_RISK
  FAILED_IMPORT
  STALE_PRICE
  BROKEN_AFFILIATE_LINK
  COMPLIANCE_FAILURE
  HIGH_OPPORTUNITY_PRODUCT
}

enum NotificationSeverity {
  INFO
  SUCCESS
  WARNING
  CRITICAL
}

enum DigestFrequency {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum ReportType {
  DAILY_OPPORTUNITY
  WEEKLY_PERFORMANCE
  MONTHLY_EARNINGS
}

enum ReportStatus {
  READY
  EXPIRED
}

enum ReportFormat {
  CSV
  JSON
}

model User {
  id              String             @id @default(cuid())
  email           String             @unique
  name            String?
  imageUrl        String?
  role            UserRole           @default(USER)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  productsCreated Product[]          @relation("ProductCreator")
  contentsCreated GeneratedContent[]
  statusChanges   PromotionStatus[]
  ingestionRuns   IngestionRun[]

  @@index([role])
}

model Marketplace {
  id                   String                  @id @default(cuid())
  name                 String                  @unique
  slug                 String                  @unique
  baseUrl              String
  isActive             Boolean                 @default(true)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  products             Product[]
  affiliateLinks       AffiliateLink[]
  sellers              Seller[]
  rules                MarketplaceRule[]
  commissionRules      CommissionRule[]
  contentPolicies      ContentPolicy[]
  affiliateDisclosures AffiliateDisclosure[]
  prohibitedPractices  ProhibitedPractice[]
  updateHistory        PlatformUpdateHistory[]
  productSources       ProductSource[]

  @@index([isActive])
}

model Seller {
  id            String      @id @default(cuid())
  marketplaceId String
  externalId    String?
  name          String
  rating        Decimal?    @db.Decimal(3, 2)
  isVerified    Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  products      Product[]
  marketplace   Marketplace @relation(fields: [marketplaceId], references: [id], onDelete: Cascade)

  @@unique([marketplaceId, externalId])
  @@index([marketplaceId, name])
}

model ProductCategory {
  id        String            @id @default(cuid())
  name      String
  slug      String            @unique
  parentId  String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  parent    ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  ProductCategory[] @relation("CategoryTree")
  products  Product[]

  @@unique([parentId, name])
  @@index([parentId])
}

model Product {
  id                     String                     @id @default(cuid())
  marketplaceId          String
  marketplaceProductId   String
  sellerId               String?
  categoryId             String?
  createdById            String?
  name                   String
  description            String?
  productUrl             String
  imageUrl               String?
  currentPrice           Decimal                    @db.Decimal(12, 2)
  originalPrice          Decimal?                   @db.Decimal(12, 2)
  currency               String                     @default("INR") @db.VarChar(3)
  rating                 Decimal?                   @db.Decimal(3, 2)
  reviewCount            Int                        @default(0)
  commissionRate         Decimal?                   @db.Decimal(5, 2)
  stockStatus            StockStatus                @default(UNKNOWN)
  returnRisk             ReturnRisk                 @default(UNKNOWN)
  status                 ProductWorkflowStatus      @default(NEW)
  notes                  String?
  isActive               Boolean                    @default(true)
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  marketplace            Marketplace                @relation(fields: [marketplaceId], references: [id], onDelete: Restrict)
  seller                 Seller?                    @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  category               ProductCategory?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdBy              User?                      @relation("ProductCreator", fields: [createdById], references: [id], onDelete: SetNull)
  priceHistory           ProductPriceHistory[]
  scores                 ProductScore[]
  generatedContent       GeneratedContent[]
  statusHistory          PromotionStatus[]
  tags                   ProductTagAssignment[]
  affiliateLinks         AffiliateLink[]
  sourcePayloads         RawSourceData[]
  sourceMatches          ProductSourceMatch[]
  trendSignals           TrendSignal[]
  sourceTrendScores      SourceTrendScore[]
  scoreEvidence          OpportunityScoreEvidence[]
  complianceChecks       ComplianceCheck[]
  savedBy                SavedProduct[]
  contentVariations      ContentVariation[]
  campaignPromotions     CampaignPromotion[]
  trackedLinks           TrackedLink[]
  contentExperiments     ContentExperiment[]
  recommendationFeedback RecommendationFeedback[]

  @@unique([marketplaceId, marketplaceProductId])
  @@index([status, isActive])
  @@index([categoryId, status])
  @@index([marketplaceId, status])
  @@index([currentPrice])
  @@index([rating])
  @@index([createdAt])
}

model ProductPriceHistory {
  id            String   @id @default(cuid())
  productId     String
  price         Decimal  @db.Decimal(12, 2)
  originalPrice Decimal? @db.Decimal(12, 2)
  currency      String   @default("INR") @db.VarChar(3)
  inStock       Boolean
  capturedAt    DateTime @default(now())
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, capturedAt])
  @@index([productId, capturedAt(sort: Desc)])
}

model ProductScore {
  id                       String   @id @default(cuid())
  productId                String
  version                  String
  opportunityScore         Decimal  @db.Decimal(5, 2)
  ratingScore              Decimal  @db.Decimal(5, 2)
  reviewVolumeScore        Decimal  @db.Decimal(5, 2)
  discountScore            Decimal  @db.Decimal(5, 2)
  commissionScore          Decimal  @db.Decimal(5, 2)
  priceAttractivenessScore Decimal  @db.Decimal(5, 2)
  sellerQualityScore       Decimal  @db.Decimal(5, 2)
  competitionScore         Decimal  @db.Decimal(5, 2)
  trendScore               Decimal  @db.Decimal(5, 2)
  demandScore              Decimal  @db.Decimal(5, 2)
  returnRiskPenalty        Decimal  @db.Decimal(5, 2)
  commissionEstimate       Decimal? @db.Decimal(12, 2)
  explanation              Json
  calculatedAt             DateTime @default(now())
  product                  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, version, calculatedAt])
  @@index([opportunityScore(sort: Desc)])
  @@index([productId, calculatedAt(sort: Desc)])
}

model GeneratedContent {
  id                 String              @id @default(cuid())
  productId          String
  createdById        String
  kind               ContentKind
  content            Json
  promptVersion      String
  provider           String
  providerModel      String
  requestId          String?
  generationError    String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdBy          User                @relation(fields: [createdById], references: [id], onDelete: Restrict)
  complianceChecks   ComplianceCheck[]
  contentVariations  ContentVariation[]
  campaignPromotions CampaignPromotion[]

  @@index([productId, createdAt(sort: Desc)])
  @@index([createdById, createdAt(sort: Desc)])
  @@index([kind])
}

model PromotionStatus {
  id        String                 @id @default(cuid())
  productId String
  changedBy String
  from      ProductWorkflowStatus?
  to        ProductWorkflowStatus
  note      String?
  changedAt DateTime               @default(now())
  product   Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User                   @relation(fields: [changedBy], references: [id], onDelete: Restrict)

  @@index([productId, changedAt(sort: Desc)])
  @@index([changedBy, changedAt(sort: Desc)])
}

model ProductTag {
  id        String                 @id @default(cuid())
  name      String
  slug      String                 @unique
  createdAt DateTime               @default(now())
  products  ProductTagAssignment[]
}

model ProductTagAssignment {
  productId String
  tagId     String
  createdAt DateTime   @default(now())
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       ProductTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
}

model AffiliateLink {
  id            String      @id @default(cuid())
  productId     String
  marketplaceId String
  url           String
  label         String?
  isPrimary     Boolean     @default(false)
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  marketplace   Marketplace @relation(fields: [marketplaceId], references: [id], onDelete: Restrict)

  @@unique([productId, url])
  @@index([productId, isPrimary])
  @@index([marketplaceId, isActive])
}

model MarketplaceRule {
  id              String       @id @default(cuid())
  marketplaceId   String
  title           String
  summary         String
  ruleType        String
  effectiveAt     DateTime
  sourceUrl       String
  status          PolicyStatus @default(NEEDS_REVIEW)
  reviewedAt      DateTime?
  reviewedByEmail String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  marketplace     Marketplace  @relation(fields: [marketplaceId], references: [id], onDelete: Cascade)

  @@unique([marketplaceId, title])
  @@index([status, effectiveAt(sort: Desc)])
}

model CommissionRule {
  id              String       @id @default(cuid())
  marketplaceId   String
  title           String
  summary         String
  category        String
  rateMin         Decimal?     @db.Decimal(6, 2)
  rateMax         Decimal?     @db.Decimal(6, 2)
  effectiveAt     DateTime
  sourceUrl       String
  status          PolicyStatus @default(NEEDS_REVIEW)
  reviewedAt      DateTime?
  reviewedByEmail String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  marketplace     Marketplace  @relation(fields: [marketplaceId], references: [id], onDelete: Cascade)

  @@unique([marketplaceId, category, effectiveAt])
  @@index([status, effectiveAt(sort: Desc)])
}

model ContentPolicy {
  id              String       @id @default(cuid())
  marketplaceId   String
  title           String
  summary         String
  channel         String
  effectiveAt     DateTime
  sourceUrl       String
  status          PolicyStatus @default(NEEDS_REVIEW)
  reviewedAt      DateTime?
  reviewedByEmail String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  marketplace     Marketplace  @relation(fields: [marketplaceId], references: [id], onDelete: Cascade)

  @@unique([marketplaceId, title])
  @@index([status, effectiveAt(sort: Desc)])
}

model AffiliateDisclosure {
  id              String       @id @default(cuid())
  marketplaceId   String
  title           String
  summary         String
  disclosureText  String
  placement       String
  effectiveAt     DateTime
  sourceUrl       String
  status          PolicyStatus @default(NEEDS_REVIEW)
  reviewedAt      DateTime?
  reviewedByEmail String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  marketplace     Marketplace  @relation(fields: [marketplaceId], references: [id], onDelete: Cascade)

  @@unique([marketplaceId, title])
  @@index([status, effectiveAt(sort: Desc)])
}

model ProhibitedPractice {
  id              String         @id @default(cuid())
  marketplaceId   String
  title           String
  summary         String
  severity        PolicySeverity @default(HIGH)
  effectiveAt     DateTime
  sourceUrl       String
  status          PolicyStatus   @default(NEEDS_REVIEW)
  reviewedAt      DateTime?
  reviewedByEmail String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  marketplace     Marketplace    @relation(fields: [marketplaceId], references: [id], onDelete: Cascade)

  @@unique([marketplaceId, title])
  @@index([status, effectiveAt(sort: Desc)])
}

model PlatformUpdateHistory {
  id              String        @id @default(cuid())
  marketplaceId   String
  policyKind      String
  policyId        String?
  changeType      String
  previousStatus  PolicyStatus?
  nextStatus      PolicyStatus?
  summary         String
  sourceUrl       String
  detectedAt      DateTime
  reviewedAt      DateTime?
  reviewedByEmail String?
  createdAt       DateTime      @default(now())
  marketplace     Marketplace   @relation(fields: [marketplaceId], references: [id], onDelete: Cascade)

  @@index([marketplaceId, detectedAt(sort: Desc)])
  @@index([policyKind, policyId])
}

model ProductSource {
  id                     String               @id @default(cuid())
  marketplaceId          String
  name                   String
  sourceType             SourceType
  status                 SourceStatus         @default(READY)
  freshnessWindowMinutes Int                  @default(1440)
  lastAttemptAt          DateTime?
  lastSuccessAt          DateTime?
  lastErrorAt            DateTime?
  consecutiveFailures    Int                  @default(0)
  rateLimitedUntil       DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  marketplace            Marketplace          @relation(fields: [marketplaceId], references: [id], onDelete: Cascade)
  runs                   IngestionRun[]
  rawPayloads            RawSourceData[]
  matches                ProductSourceMatch[]
  errors                 IngestionError[]
  schedule               IngestionSchedule?
  trendSignals           TrendSignal[]

  @@unique([marketplaceId, name])
  @@index([status, lastSuccessAt(sort: Desc)])
}

model IngestionRun {
  id             String               @id @default(cuid())
  sourceId       String
  parentRunId    String?
  triggerType    IngestionTriggerType
  status         IngestionRunStatus
  initiatedById  String
  startedAt      DateTime             @default(now())
  completedAt    DateTime?
  attemptedCount Int                  @default(0)
  importedCount  Int                  @default(0)
  updatedCount   Int                  @default(0)
  matchedCount   Int                  @default(0)
  duplicateCount Int                  @default(0)
  failedCount    Int                  @default(0)
  retryCount     Int                  @default(0)
  nextRetryAt    DateTime?
  errorSummary   String?
  source         ProductSource        @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  initiatedBy    User                 @relation(fields: [initiatedById], references: [id], onDelete: Restrict)
  parentRun      IngestionRun?        @relation("IngestionRetries", fields: [parentRunId], references: [id], onDelete: SetNull)
  retryRuns      IngestionRun[]       @relation("IngestionRetries")
  rawPayloads    RawSourceData[]
  errors         IngestionError[]

  @@index([sourceId, startedAt(sort: Desc)])
  @@index([status, nextRetryAt])
}

model CanonicalProductGroup {
  id             String               @id @default(cuid())
  canonicalKey   String               @unique
  normalizedName String
  brand          String?
  category       String
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  rawPayloads    RawSourceData[]
  sourceMatches  ProductSourceMatch[]

  @@index([category])
}

model RawSourceData {
  id                 String                 @id @default(cuid())
  sourceId           String
  runId              String
  canonicalGroupId   String?
  productId          String?
  externalId         String
  payload            Json
  payloadHash        String
  normalizedProduct  Json?
  sourceTimestamp    DateTime
  receivedAt         DateTime               @default(now())
  confidence         Decimal                @db.Decimal(5, 4)
  matchStatus        MatchStatus
  availabilityStatus AvailabilityStatus
  isStale            Boolean                @default(false)
  source             ProductSource          @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  run                IngestionRun           @relation(fields: [runId], references: [id], onDelete: Cascade)
  canonicalGroup     CanonicalProductGroup? @relation(fields: [canonicalGroupId], references: [id], onDelete: SetNull)
  product            Product?               @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([sourceId, externalId, payloadHash])
  @@index([runId, receivedAt(sort: Desc)])
  @@index([productId, sourceTimestamp(sort: Desc)])
  @@index([isStale, availabilityStatus])
}

model ProductSourceMatch {
  id               String                @id @default(cuid())
  sourceId         String
  canonicalGroupId String
  productId        String?
  externalId       String
  confidence       Decimal               @db.Decimal(5, 4)
  status           MatchStatus
  matchedAt        DateTime              @default(now())
  source           ProductSource         @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  canonicalGroup   CanonicalProductGroup @relation(fields: [canonicalGroupId], references: [id], onDelete: Cascade)
  product          Product?              @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([sourceId, externalId])
  @@index([canonicalGroupId, status])
}

model IngestionError {
  id         String        @id @default(cuid())
  runId      String
  sourceId   String
  externalId String?
  code       String
  message    String
  retryable  Boolean       @default(false)
  attempt    Int           @default(1)
  occurredAt DateTime      @default(now())
  resolvedAt DateTime?
  run        IngestionRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  source     ProductSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([runId, occurredAt(sort: Desc)])
  @@index([sourceId, resolvedAt])
}

model IngestionSchedule {
  id             String        @id @default(cuid())
  sourceId       String        @unique
  cadenceMinutes Int
  enabled        Boolean       @default(false)
  nextRunAt      DateTime?
  lastRunAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  source         ProductSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([enabled, nextRunAt])
}

model TrendSignal {
  id              String          @id @default(cuid())
  productId       String
  sourceId        String?
  signalType      TrendSignalType
  value           Decimal         @db.Decimal(18, 4)
  normalizedScore Decimal         @db.Decimal(5, 2)
  confidence      Decimal         @db.Decimal(5, 4)
  observedAt      DateTime
  expiresAt       DateTime?
  metadata        Json
  createdAt       DateTime        @default(now())
  product         Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  source          ProductSource?  @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([productId, observedAt(sort: Desc)])
  @@index([signalType, observedAt(sort: Desc)])
  @@index([sourceId, observedAt(sort: Desc)])
}

model SourceTrendScore {
  id           String         @id @default(cuid())
  productId    String
  sourceName   String
  windowDays   Int
  score        Decimal        @db.Decimal(5, 2)
  confidence   Decimal        @db.Decimal(5, 4)
  signalCount  Int
  direction    TrendDirection
  calculatedAt DateTime       @default(now())
  provenance   Json
  product      Product        @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, sourceName, windowDays, calculatedAt])
  @@index([score(sort: Desc), calculatedAt(sort: Desc)])
}

model OpportunityScoreEvidence {
  id                     String                   @id @default(cuid())
  productId              String
  version                String
  marketplace            String
  category               String
  opportunityScore       Decimal                  @db.Decimal(5, 2)
  input                  Json
  weights                Json
  breakdown              Json
  penalties              Json
  explanation            Json
  calculatedAt           DateTime                 @default(now())
  product                Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  recommendationFeedback RecommendationFeedback[]

  @@index([productId, calculatedAt(sort: Desc)])
  @@index([version, opportunityScore(sort: Desc)])
}

model ComplianceCheck {
  id                 String                  @id @default(cuid())
  productId          String
  generatedContentId String?
  marketplace        String
  status             ComplianceStatus
  highestSeverity    ComplianceSeverity
  contentHash        String
  checkedByEmail     String
  checkedAt          DateTime                @default(now())
  overriddenAt       DateTime?
  overriddenByEmail  String?
  overrideReason     String?
  product            Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  generatedContent   GeneratedContent?       @relation(fields: [generatedContentId], references: [id], onDelete: SetNull)
  results            ComplianceCheckResult[]
  overrides          ComplianceOverride[]

  @@index([productId, checkedAt(sort: Desc)])
  @@index([status, highestSeverity])
  @@index([generatedContentId])
}

model ComplianceCheckResult {
  id            String             @id @default(cuid())
  checkId       String
  ruleCode      String
  status        ComplianceStatus
  severity      ComplianceSeverity
  message       String
  fixSuggestion String?
  evidence      Json
  createdAt     DateTime           @default(now())
  check         ComplianceCheck    @relation(fields: [checkId], references: [id], onDelete: Cascade)

  @@unique([checkId, ruleCode])
  @@index([status, severity])
}

model ComplianceOverride {
  id                String           @id @default(cuid())
  checkId           String
  fromStatus        ComplianceStatus
  toStatus          ComplianceStatus
  reason            String
  overriddenByEmail String
  createdAt         DateTime         @default(now())
  check             ComplianceCheck  @relation(fields: [checkId], references: [id], onDelete: Cascade)

  @@index([checkId, createdAt(sort: Desc)])
  @@index([overriddenByEmail, createdAt(sort: Desc)])
}

model SavedProduct {
  id        String   @id @default(cuid())
  productId String
  userEmail String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userEmail, productId])
  @@index([userEmail, createdAt(sort: Desc)])
}

model CreatorAccount {
  id          String     @id @default(cuid())
  ownerEmail  String
  platform    String
  handle      String
  displayName String?
  externalId  String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  campaigns   Campaign[]

  @@unique([ownerEmail, platform, handle])
  @@index([ownerEmail, isActive])
}

model Campaign {
  id                 String              @id @default(cuid())
  ownerEmail         String
  creatorAccountId   String?
  name               String
  objective          String
  channel            String
  startsAt           DateTime?
  endsAt             DateTime?
  budget             Decimal?            @db.Decimal(14, 2)
  currency           String              @default("INR") @db.VarChar(3)
  status             CampaignStatus      @default(DRAFT)
  notes              String?
  templateName       String?
  duplicatedFromId   String?
  archivedAt         DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  creatorAccount     CreatorAccount?     @relation(fields: [creatorAccountId], references: [id], onDelete: SetNull)
  duplicatedFrom     Campaign?           @relation("CampaignDuplicates", fields: [duplicatedFromId], references: [id], onDelete: SetNull)
  duplicates         Campaign[]          @relation("CampaignDuplicates")
  promotions         CampaignPromotion[]
  trackedLinks       TrackedLink[]
  contentExperiments ContentExperiment[]

  @@index([ownerEmail, status, updatedAt(sort: Desc)])
  @@index([ownerEmail, channel, startsAt(sort: Desc)])
  @@index([ownerEmail, name])
  @@index([creatorAccountId])
}

model ContentVariation {
  id                 String                 @id @default(cuid())
  ownerEmail         String
  productId          String
  generatedContentId String?
  label              String
  hook               String?
  caption            String?
  cta                String?
  hashtags           Json                   @default("[]")
  audienceAngle      String?
  contentLength      String?
  tone               String?
  platform           String
  status             ContentVariationStatus @default(ACTIVE)
  isWinner           Boolean                @default(false)
  archivedAt         DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  product            Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  generatedContent   GeneratedContent?      @relation(fields: [generatedContentId], references: [id], onDelete: SetNull)
  promotions         CampaignPromotion[]
  trackedLinks       TrackedLink[]
  experimentEntries  ExperimentVariation[]
  experimentResults  ExperimentResult[]
  winningExperiments ContentExperiment[]    @relation("ExperimentWinner")

  @@unique([ownerEmail, productId, label])
  @@index([productId, status])
  @@index([generatedContentId])
}

model CampaignPromotion {
  id                 String                  @id @default(cuid())
  ownerEmail         String
  campaignId         String
  productId          String
  generatedContentId String?
  contentVariationId String?
  status             CampaignPromotionStatus @default(PLANNED)
  scheduledAt        DateTime?
  publishedAt        DateTime?
  publishedUrl       String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  campaign           Campaign                @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  product            Product                 @relation(fields: [productId], references: [id], onDelete: Restrict)
  generatedContent   GeneratedContent?       @relation(fields: [generatedContentId], references: [id], onDelete: SetNull)
  contentVariation   ContentVariation?       @relation(fields: [contentVariationId], references: [id], onDelete: SetNull)
  trackedLinks       TrackedLink[]

  @@index([ownerEmail, status, updatedAt(sort: Desc)])
  @@index([campaignId, publishedAt(sort: Desc)])
  @@index([productId, publishedAt(sort: Desc)])
  @@index([contentVariationId])
}

model TrackedLink {
  id                 String            @id @default(cuid())
  ownerEmail         String
  promotionId        String
  campaignId         String
  productId          String
  contentVariationId String?
  marketplace        String
  trackingId         String            @unique
  shortPath          String            @unique
  destinationUrl     String
  isActive           Boolean           @default(true)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  promotion          CampaignPromotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  campaign           Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  product            Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  contentVariation   ContentVariation? @relation(fields: [contentVariationId], references: [id], onDelete: SetNull)
  clicks             ClickEvent[]
  conversions        ConversionEvent[]

  @@index([ownerEmail, isActive])
  @@index([campaignId])
  @@index([productId])
}

model ClickEvent {
  id               String             @id @default(cuid())
  trackedLinkId    String
  clickedAt        DateTime           @default(now())
  trafficSource    String?
  deviceType       TrackingDeviceType @default(UNKNOWN)
  region           String?
  fingerprintHash  String?
  isBot            Boolean            @default(false)
  isDuplicate      Boolean            @default(false)
  suspiciousReason String?
  createdAt        DateTime           @default(now())
  trackedLink      TrackedLink        @relation(fields: [trackedLinkId], references: [id], onDelete: Cascade)
  conversions      ConversionEvent[]

  @@index([trackedLinkId, clickedAt(sort: Desc)])
  @@index([isBot, isDuplicate, clickedAt(sort: Desc)])
  @@index([fingerprintHash, clickedAt(sort: Desc)])
}

model ConversionEvent {
  id                  String               @id @default(cuid())
  ownerEmail          String
  trackedLinkId       String
  clickEventId        String?
  marketplace         String
  externalOrderIdHash String
  orderStatus         AffiliateOrderStatus
  orderValue          Decimal?             @db.Decimal(14, 2)
  currency            String               @default("INR") @db.VarChar(3)
  convertedAt         DateTime
  importedAt          DateTime             @default(now())
  trackedLink         TrackedLink          @relation(fields: [trackedLinkId], references: [id], onDelete: Restrict)
  clickEvent          ClickEvent?          @relation(fields: [clickEventId], references: [id], onDelete: SetNull)
  commissions         CommissionEvent[]

  @@unique([marketplace, externalOrderIdHash])
  @@index([ownerEmail, convertedAt(sort: Desc)])
  @@index([trackedLinkId, orderStatus])
}

model CommissionEvent {
  id                String                    @id @default(cuid())
  ownerEmail        String
  conversionEventId String
  marketplace       String
  amount            Decimal                   @db.Decimal(14, 2)
  currency          String                    @default("INR") @db.VarChar(3)
  status            AffiliateCommissionStatus
  observedAt        DateTime
  approvedAt        DateTime?
  importedAt        DateTime                  @default(now())
  conversionEvent   ConversionEvent           @relation(fields: [conversionEventId], references: [id], onDelete: Cascade)

  @@unique([conversionEventId, status, observedAt])
  @@index([ownerEmail, status, observedAt(sort: Desc)])
  @@index([marketplace, observedAt(sort: Desc)])
}

model ContentExperiment {
  id                  String                  @id @default(cuid())
  ownerEmail          String
  productId           String
  campaignId          String?
  name                String
  hypothesis          String
  primaryMetric       ExperimentPrimaryMetric
  status              ContentExperimentStatus @default(DRAFT)
  confidenceThreshold Decimal                 @default(0.95) @db.Decimal(5, 4)
  winnerVariationId   String?
  startedAt           DateTime?
  endedAt             DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  product             Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  campaign            Campaign?               @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  winnerVariation     ContentVariation?       @relation("ExperimentWinner", fields: [winnerVariationId], references: [id], onDelete: SetNull)
  variations          ExperimentVariation[]
  results             ExperimentResult[]

  @@index([ownerEmail, status, updatedAt(sort: Desc)])
  @@index([productId, createdAt(sort: Desc)])
  @@index([campaignId])
  @@index([winnerVariationId])
}

model ExperimentVariation {
  experimentId      String
  variationId       String
  allocationPercent Decimal           @db.Decimal(5, 2)
  createdAt         DateTime          @default(now())
  experiment        ContentExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  variation         ContentVariation  @relation(fields: [variationId], references: [id], onDelete: Cascade)

  @@id([experimentId, variationId])
  @@index([variationId])
}

model ExperimentResult {
  id               String            @id @default(cuid())
  experimentId     String
  variationId      String
  sampleSize       Int
  clicks           Int
  conversions      Int
  commission       Decimal           @db.Decimal(14, 2)
  conversionRate   Decimal           @db.Decimal(8, 4)
  earningsPerClick Decimal           @db.Decimal(14, 4)
  confidence       Decimal           @db.Decimal(5, 4)
  calculatedAt     DateTime          @default(now())
  experiment       ContentExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  variation        ContentVariation  @relation(fields: [variationId], references: [id], onDelete: Cascade)

  @@unique([experimentId, variationId, calculatedAt])
  @@index([experimentId, confidence(sort: Desc)])
}

model RecommendationFeedback {
  id              String                       @id @default(cuid())
  ownerEmail      String
  productId       String
  scoreEvidenceId String?
  action          RecommendationFeedbackAction
  reason          String?
  audience        String?
  season          String?
  festival        String?
  metadata        Json                         @default("{}")
  recordedAt      DateTime                     @default(now())
  product         Product                      @relation(fields: [productId], references: [id], onDelete: Cascade)
  scoreEvidence   OpportunityScoreEvidence?    @relation(fields: [scoreEvidenceId], references: [id], onDelete: SetNull)

  @@index([ownerEmail, action, recordedAt(sort: Desc)])
  @@index([productId, recordedAt(sort: Desc)])
  @@index([scoreEvidenceId])
}

model LearningProfile {
  id                String            @id @default(cuid())
  ownerEmail        String
  dimension         LearningDimension
  dimensionKey      String
  observationCount  Int
  promotionCount    Int
  conversionCount   Int
  conversionRate    Decimal           @db.Decimal(8, 4)
  averageCommission Decimal           @db.Decimal(14, 4)
  earningsPerClick  Decimal           @db.Decimal(14, 4)
  confidence        Decimal           @db.Decimal(5, 4)
  evidenceFrom      DateTime
  evidenceTo        DateTime
  updatedAt         DateTime          @updatedAt

  @@unique([ownerEmail, dimension, dimensionKey])
  @@index([ownerEmail, confidence(sort: Desc)])
}

model ScoringWeightVersion {
  id                String                 @id @default(cuid())
  version           String                 @unique
  status            ScoringWeightStatus    @default(DRAFT)
  weights           Json
  evidenceFrom      DateTime
  evidenceTo        DateTime
  observationCount  Int
  reason            String
  previousVersionId String?
  createdByEmail    String
  createdAt         DateTime               @default(now())
  activatedAt       DateTime?
  rolledBackAt      DateTime?
  previousVersion   ScoringWeightVersion?  @relation("ScoringWeightHistory", fields: [previousVersionId], references: [id], onDelete: SetNull)
  nextVersions      ScoringWeightVersion[] @relation("ScoringWeightHistory")

  @@index([status, createdAt(sort: Desc)])
}

model RecommendationQualitySnapshot {
  id                  String   @id @default(cuid())
  ownerEmail          String
  modelVersion        String
  recommendationCount Int
  approvalRate        Decimal  @db.Decimal(8, 4)
  promotionRate       Decimal  @db.Decimal(8, 4)
  conversionRate      Decimal  @db.Decimal(8, 4)
  averageCommission   Decimal  @db.Decimal(14, 4)
  confidence          Decimal  @db.Decimal(5, 4)
  windowFrom          DateTime
  windowTo            DateTime
  calculatedAt        DateTime @default(now())

  @@unique([ownerEmail, modelVersion, windowFrom, windowTo])
  @@index([ownerEmail, calculatedAt(sort: Desc)])
}

model AutomationJob {
  id                  String              @id @default(cuid())
  jobKey              String              @unique
  jobType             AutomationJobType
  name                String
  description         String
  cronExpression      String
  timezone            String              @default("Asia/Kolkata")
  enabled             Boolean             @default(false)
  status              AutomationJobStatus @default(PAUSED)
  timeoutSeconds      Int                 @default(300)
  maxAttempts         Int                 @default(3)
  retryBaseSeconds    Int                 @default(60)
  dependsOnJobId      String?
  nextRunAt           DateTime?
  lastRunAt           DateTime?
  lastSuccessAt       DateTime?
  lastFailureAt       DateTime?
  consecutiveFailures Int                 @default(0)
  createdByEmail      String
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  dependsOnJob        AutomationJob?      @relation("AutomationDependencies", fields: [dependsOnJobId], references: [id], onDelete: SetNull)
  dependentJobs       AutomationJob[]     @relation("AutomationDependencies")
  runs                AutomationRun[]

  @@index([enabled, status, nextRunAt])
  @@index([status, consecutiveFailures])
}

model AutomationRun {
  id               String               @id @default(cuid())
  jobId            String
  parentRunId      String?
  triggerType      AutomationRunTrigger
  status           AutomationRunStatus  @default(QUEUED)
  attempt          Int                  @default(1)
  scheduledFor     DateTime?
  queuedAt         DateTime             @default(now())
  startedAt        DateTime?
  completedAt      DateTime?
  timeoutAt        DateTime?
  initiatedByEmail String?
  processedCount   Int                  @default(0)
  succeededCount   Int                  @default(0)
  failedCount      Int                  @default(0)
  metrics          Json                 @default("{}")
  errorCode        String?
  errorSummary     String?
  nextRetryAt      DateTime?
  job              AutomationJob        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  parentRun        AutomationRun?       @relation("AutomationRetries", fields: [parentRunId], references: [id], onDelete: SetNull)
  retryRuns        AutomationRun[]      @relation("AutomationRetries")
  logs             AutomationRunLog[]

  @@index([jobId, queuedAt(sort: Desc)])
  @@index([status, nextRetryAt])
  @@index([parentRunId])
}

model AutomationRunLog {
  id         String             @id @default(cuid())
  runId      String
  level      AutomationLogLevel
  event      String
  message    String
  metadata   Json               @default("{}")
  occurredAt DateTime           @default(now())
  run        AutomationRun      @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, occurredAt])
  @@index([level, occurredAt(sort: Desc)])
}

model NotificationPreference {
  id              String          @id @default(cuid())
  ownerEmail      String          @unique
  inAppEnabled    Boolean         @default(true)
  emailEnabled    Boolean         @default(false)
  digestFrequency DigestFrequency @default(DAILY)
  enabledTypes    Json            @default("[]")
  quietHoursStart String?
  quietHoursEnd   String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model Notification {
  id         String                 @id @default(cuid())
  ownerEmail String
  type       NotificationType
  severity   NotificationSeverity
  title      String
  body       String
  actionUrl  String?
  entityType String?
  entityId   String?
  dedupeKey  String
  metadata   Json                   @default("{}")
  readAt     DateTime?
  createdAt  DateTime               @default(now())
  expiresAt  DateTime?
  deliveries NotificationDelivery[]

  @@unique([ownerEmail, dedupeKey])
  @@index([ownerEmail, readAt, createdAt(sort: Desc)])
  @@index([ownerEmail, type, createdAt(sort: Desc)])
}

model NotificationDelivery {
  id                    String                     @id @default(cuid())
  notificationId        String
  channel               NotificationChannel
  status                NotificationDeliveryStatus @default(PENDING)
  provider              String?
  externalMessageIdHash String?
  attemptCount          Int                        @default(0)
  nextAttemptAt         DateTime?
  deliveredAt           DateTime?
  errorCode             String?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  notification          Notification               @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel])
  @@index([status, nextAttemptAt])
}

model GeneratedReport {
  id          String       @id @default(cuid())
  ownerEmail  String
  type        ReportType
  title       String
  periodFrom  DateTime
  periodTo    DateTime
  status      ReportStatus @default(READY)
  format      ReportFormat @default(CSV)
  content     Json
  rowCount    Int
  generatedAt DateTime     @default(now())
  expiresAt   DateTime

  @@unique([ownerEmail, type, periodFrom, periodTo])
  @@index([ownerEmail, generatedAt(sort: Desc)])
  @@index([expiresAt])
}
