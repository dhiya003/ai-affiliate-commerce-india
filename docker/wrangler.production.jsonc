{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "affinity-india",
  "main": "../dist/server/index.js",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "ENVIRONMENT_VALIDATION_MODE": "strict",
    "ADMIN_EMAILS": "dhiviyalakshmi03@gmail.com",
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "../dist/client",
  },
  "images": {
    "binding": "IMAGES",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "affinity-india-production",
      "database_id": "a5fbdc00-78c2-44ab-aa28-148b6ec85f4d",
      "migrations_dir": "../drizzle",
    },
  ],
  "triggers": {
    "crons": ["*/5 * * * *"],
  },
  "observability": {
    "enabled": true,
  },
}
